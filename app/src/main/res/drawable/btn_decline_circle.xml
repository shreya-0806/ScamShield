<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Decline Button (Circular)
    Purpose: RED circular button for declining/ending calls
    Used in: InCallActivity - incoming call screen (right button)
    Dimensions: 72dp x 72dp (as specified in activity_in_call.xml)
    Color: Red (#F44336) - indicates rejection/decline action
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#F44336" />
    <size android:width="140dp" android:height="140dp" />
</shape>
